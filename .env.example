# Copy to .env. Docker Compose reads this file for variable substitution.
#
# Database switch (gitignored files — never commit passwords):
#   .env              → remote Supabase Free (default for local→prod-like data)
#   .env.local.docker → standalone Compose Postgres (offline / isolated)
# Remote from WSL: Free direct host is IPv6-only and the shared pooler rejects
# custom roles — start the VPS tunnel first:
#   bash ../infra/scripts/supabase_dev_tunnel.sh -f
#   python3 ../infra/scripts/write_local_supabase_env.py
# Then DATABASE_* use 127.0.0.1:15432. If your host has IPv6 to Supabase, you can
# point at db.zgoscslzyizwnzqoyqul.supabase.co:5432 instead (--direct).
# asyncpg: statement_cache_size=0 is set in code (pooler-safe).
#
# Placeholders below are the standalone local-db shape (also .env.local.docker).
DATABASE_URL=postgresql+asyncpg://argus_app:argus_app@postgres:5432/argus
ADMIN_DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=argus-frames
S3_REGION=us-east-1

# Stream gateway / stream-prep.
STREAM_GATEWAY_TOKEN=dev-stream-gateway-token
STREAM_GATEWAY_URL=http://stream-gateway:1984
API_INTERNAL_URL=http://api:8000
SAMPLE_FPS=1
FRAME_TTL=3600
POLL_INTERVAL=30
WINDOW_SIZE=6
ALLOW_SYNTHETIC_FRAMES=true

# Browser-facing HTTP origins (localhost + 127.0.0.1 for CORS/SSO).
CORS_ORIGINS=http://localhost:8180,http://localhost:8181,http://127.0.0.1:8180,http://127.0.0.1:8181
VITE_SSO_RETURN_ORIGINS=http://localhost:8180,http://localhost:8181,http://127.0.0.1:8180,http://127.0.0.1:8181
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://api:8000
VITE_MAIN_ORIGIN=http://localhost:8180
VITE_SUPPORT_ORIGIN=http://localhost:8181
TRIAGE_PUBLIC_ORIGIN=http://localhost:8181

# Mock auth / app bootstrap.
AUTH0_USE_MOCK=true
AUTH0_DOMAIN=dev.local
AUTH0_API_AUDIENCE=http://localhost:8800
AUTH0_ALGORITHMS=RS256
AUTH0_CLAIMS_NAMESPACE=http://argus.local
DEV_JWT_SECRET=local-dev-secret-change-me
DEV_ROOT_EMAIL=root@argus.local
DEV_ROOT_PASSWORD=local-root-password

# Worker / notifications.
# Headroom switch (Gemini + OpenAI):
#   LLM_USE_HEADROOM=true  → base URLs → Headroom (local :8787 / prod http://headroom:8787)
#   LLM_USE_HEADROOM=false → public provider APIs
LLM_USE_HEADROOM=true
OPENAI_API_KEY=
# When Headroom ON: http://localhost:8787/v1 (prod: http://headroom:8787/v1)
OPENAI_BASE_URL=http://localhost:8787/v1

# LLM provider chain and model ranking (OWASP guardrails staging limits).
# Embeddings remain OpenAI-only (text-embedding-3-small) with a SHA-256 fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# When Headroom ON: http://localhost:8787 (prod: http://headroom:8787)
GEMINI_BASE_URL=http://localhost:8787
LLM_PROVIDER_ORDER=gemini,openai
MODEL_RANK_REFRESH_MS=43200000
MODEL_RANK_TOP_N=3
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=500
LLM_GLOBAL_DAILY_BUDGET=5000
LLM_DAILY_TOKEN_BUDGET=0
LLM_DAILY_COST_USD=0
VLM_MIN_CONFIDENCE_FOR_HINT=0.55
FRAME_HTTP_ALLOWLIST=
RATE_LIMIT_PER_MINUTE=30

NOTIFICATION_MODE=log
EVENT_TRANSPORT=log
DEV_NOTIFY_FAIL=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
EVENTBRIDGE_BUS_NAME=default
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# API bind / logging.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
