# Copy to .env. This is the single development configuration file.
# Compose injects these values into every ARGUS service.

# Host-facing URLs. Compose overrides these with internal service names.
DATABASE_URL=postgresql+asyncpg://argus_app:argus_app@localhost:5432/argus
ADMIN_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=argus-frames
S3_REGION=us-east-1

# Authentication: mock mode is deterministic and browser-playable.
AUTH0_USE_MOCK=true
AUTH0_DOMAIN=dev.argus.local
AUTH0_API_AUDIENCE=https://api.argus.local
AUTH0_ALGORITHMS=HS256
AUTH0_CLAIMS_NAMESPACE=https://argus.local
DEV_JWT_SECRET=local-development-secret-change-me-32

# Analysis provider. Empty key uses the deterministic local VLM.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Event sink: log, sns, or eventbridge.
EVENT_TRANSPORT=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
EVENTBRIDGE_BUS_NAME=default

# Notifications never send in development unless explicitly changed to twilio.
NOTIFICATION_MODE=log
DEV_NOTIFY_FAIL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

API_HOST=0.0.0.0
LOG_LEVEL=INFO
