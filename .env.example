# Copy to .env. Docker Compose reads this file for all services.

# Database and cache live inside the compose network.
DATABASE_URL=postgresql+asyncpg://argus_app:argus_app@postgres:5432/argus
ADMIN_DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=argus-frames
S3_REGION=us-east-1

# Browser-facing HTTP origins.
CORS_ORIGINS=http://admin.argus.test:8180,http://triage.argus.test:8181
SSO_RETURN_ORIGINS=http://admin.argus.test:8180,http://triage.argus.test:8181
VITE_SSO_RETURN_ORIGINS=http://admin.argus.test:8180,http://triage.argus.test:8181
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://api:8000
VITE_MAIN_ORIGIN=http://admin.argus.test:8180
VITE_SUPPORT_ORIGIN=http://triage.argus.test:8181

# Mock auth / app bootstrap.
AUTH0_USE_MOCK=true
AUTH0_DOMAIN=auth.argus.test
AUTH0_API_AUDIENCE=http://api.argus.test:8800
AUTH0_ALGORITHMS=RS256
AUTH0_CLAIMS_NAMESPACE=http://argus.local
DEV_JWT_SECRET=local-dev-secret-change-me
DEV_ROOT_EMAIL=root@argus.local
DEV_ROOT_PASSWORD=local-root-password

# Worker / notifications.
OPENAI_API_KEY=
OPENAI_BASE_URL=
NOTIFICATION_MODE=log
EVENT_TRANSPORT=log
DEV_NOTIFY_FAIL=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
EVENTBRIDGE_BUS_NAME=default
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# API bind / logging.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
