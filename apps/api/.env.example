# Copy the repository root .env.example to .env. This file is retained as a
# reference for running a single service directly from backend/.
# Service role: api-admin | api-ingest | ws-gateway | worker-vlm |
# worker-aggregator | worker-notify | worker-scheduler
SERVICE_ROLE=api-admin

# PostgreSQL (asyncpg DSN) — use argus_app at runtime (RLS enforced); argus superuser for migrations only
DATABASE_URL=postgresql+asyncpg://argus_app:argus_app@postgres:5432/argus
ADMIN_DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus

# Redis (broker, streams, pub/sub, cache)
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=argus-frames
S3_REGION=us-east-1

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=http://api.argus.test:8800
AUTH0_CLIENT_ID=
AUTH0_ALGORITHMS=RS256
AUTH0_USE_MOCK=true
AUTH0_CLAIMS_NAMESPACE=http://argus.local
DEV_JWT_SECRET=local-development-secret-change-me-32
DEV_ROOT_EMAIL=root@argus.local
DEV_ROOT_PASSWORD=replace-with-setup-generated-password
NOTIFICATION_MODE=log
DEV_NOTIFY_FAIL=false
EVENT_TRANSPORT=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
EVENTBRIDGE_BUS_NAME=default
OPENAI_BASE_URL=

# OpenAI (VLM analysis)
OPENAI_API_KEY=sk-your-openai-key

# Twilio (SMS / WhatsApp notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+15551234567

# API bind (HTTP services only)
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
