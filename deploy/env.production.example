# Argus — Dokploy panel environment template (NAMES ONLY — paste real values in
# the Dokploy panel). Never commit filled values. Derived from
# apps/api/src/argus/config.py + infra/scripts/config.py compose("argus", …).

# ——— Database (existing Supabase project; NEVER repoint elsewhere) ———
# Pooler shape: host aws-0-eu-west-1.pooler.supabase.com, DB postgres, schema argus.
# port 6543 = pgBouncer pooled (Datasource URLs, pgbouncer transaction mode
# needs prepared-statement caching disabled — add ?statement_cache_size=0 for
# asyncpg); port 5432 = direct (sessions, use for ADMIN when possible).
# Owner role `argus` (migrations) vs runtime role `argus_app` (NOBYPASSRLS) —
# the two roles must NEVER be merged into one connection.
# DATABASE_URL=postgresql+asyncpg://argus_app:<pw>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?statement_cache_size=0
# ADMIN_DATABASE_URL=postgresql+asyncpg://argus:<pw>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?statement_cache_size=0

# ——— Redis (per-app, password, noeviction, DB /1 in prod) ———
# REDIS_PASSWORD=
# Compose renders REDIS_URL as redis://:<REDIS_PASSWORD>@redis:6379/1 when unset;
# set it explicitly only if you move the Redis.
# REDIS_URL=redis://:<pass>@redis:6379/1

# ——— Object storage (Garage v2.4.1 S3-compatible, platform stack) ———
# S3_ENDPOINT_URL=http://object-store:9000
# S3_PUBLIC_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=argus-frames
# S3_REGION=us-east-1

# ——— Streams / vision pipeline ———
# STREAM_GATEWAY_TOKEN=
# STREAM_GATEWAY_URL=http://stream-gateway:1984
# API_INTERNAL_URL=http://api:8000
# SAMPLE_FPS (panel name ARGUS_SAMPLE_FPS) — default 3
# WINDOW_SIZE (panel name ARGUS_STREAM_WINDOW_SIZE) — default 45 → 15 s window
# ARGUS_SAMPLE_FPS=3
# ARGUS_STREAM_WINDOW_SIZE=45
# ALLOW_SYNTHETIC_FRAMES=false
# POLL_INTERVAL=30
# FRAME_TTL=3600
# LATEST_FRAME_ENABLED=true
# LATEST_FRAME_TTL=30
# ——— edge-cv knobs (kept per infra/scripts/config.py) ———
# EDGE_CV_ENABLED=true
# EDGE_TENSORRT_ENABLED=false
# EDGE_YOLO_MODEL=/opt/models/yolov8n.pt
# TORCH_HOME=/opt/models/torch
# YOLO_CONFIG_DIR=/tmp/ultralytics
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# EDGE_IDLE_FPS=0.5
# EDGE_BURST_FPS=3
# EDGE_BURST_SECONDS=10
# EDGE_MOTION_THRESHOLD=0.02
# EDGE_MAX_KEYFRAMES=3
# EDGE_SENSOR_WINDOW_SECONDS=5

# ——— LLM: Headroom proxy (platform stack) with verified production pin ———
# LLM_USE_HEADROOM=true
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=http://headroom:8787
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# No OpenAI (retired): Gemini (+ Headroom) is the sole LLM path for Argus.
# JEV reserved (not consumed by Argus MVP yet � provision in panel anyway):
# JEV_API_KEY=
# ARGUS_JEV_API_KEY=          # alias of JEV_API_KEY
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_SECONDS=10
# JEV_CLASSIFY_MODE=shadow
# JEV_MAPPING_MODE=shadow
# JEV_JUDGE_MODE=shadow
# JEV_SHADOW_RATE_PER_MINUTE=10
# JEV_SHADOW_DAILY_CALLS=500
# No MODEL_RANK_* � trust GEMINI_MODEL; no Celery models.list refresh.
# LLM_PROVIDER_ORDER=gemini
# LLM_RATE_LIMIT_PER_MINUTE=20
# LLM_DAILY_BUDGET=500
# LLM_GLOBAL_DAILY_BUDGET=5000
# LLM_DAILY_TOKEN_BUDGET=0
# LLM_DAILY_COST_USD=0
# LLM_ESTIMATED_TOKENS_PER_CALL=4000
# LLM_ESTIMATED_COST_PER_CALL_USD=0.01
# VLM_MIN_CONFIDENCE_FOR_HINT=0.55
# FRAME_HTTP_ALLOWLIST=

# ——— Auth (repo uses its own mock envelope: keep AUTH0_* names) ———
# AUTH0_USE_MOCK=true          # MVP: mock stays true; production Auth0 is a separate task
# AUTH0_DOMAIN=<your-tenant>.auth0.com
# AUTH0_API_AUDIENCE=https://api.argus.ferredemo.dev
# AUTH0_ALGORITHMS=RS256
# AUTH0_CLAIMS_NAMESPACE=http://argus.local
# DEV_JWT_SECRET=

# ——— Bootstrap / demo seed (migrate service only) ———
# DEV_ROOT_EMAIL=root@argus.local
# DEV_ROOT_PASSWORD=
# SEED_DEMO=0
# DEMO_PASSWORD=              # demo passwords panel-only
# ARGUS_APP_ROLE_PASSWORD=    # used only if the argus_app role must be created

# ——— Notifications (AWS free tier; off unless enabled) ———
# NOTIFICATION_MODE=log       # log | twilio
# EVENT_TRANSPORT=log         # log | sns | eventbridge
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SNS_TOPIC_ARN=
# EVENTBRIDGE_BUS_NAME=default
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# ——— API bind, CORS, logging, release ———
# CORS_ORIGINS=https://app.argus.ferredemo.dev,https://triage.argus.ferredemo.dev
# TRIAGE_PUBLIC_ORIGIN=https://triage.argus.ferredemo.dev
# RATE_LIMIT_PER_MINUTE=30
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO
# GIT_SHA=<set from the released commit SHA (CI tags the images, not compose)>
# IMAGE_TAG=production

# ——— Tier / profile switch (see deploy/tiers/) ———
# COMPOSE_PROFILES=pipeline   # set on the 16 GB tier; OMIT on the 8 GB tier
# SKIP_MIGRATIONS=0           # set to 1 momentarily when rolling back migrations
