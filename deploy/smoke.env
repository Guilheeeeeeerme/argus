# Placeholder values for `docker compose config` validation and the runner
# smoke (deploy/smoke.compose.yml overrides them for local Postgres/MinIO).
# These are throwaway smoke values, NOT production secrets.
IMAGE_TAG=production
DATABASE_URL=postgresql+asyncpg://argus_app:argus_app@postgres:5432/argus
ADMIN_DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus
REDIS_PASSWORD=smoke-redis-password
REDIS_URL=redis://:smoke-redis-password@redis:6379/1
STREAM_GATEWAY_TOKEN=smoke-stream-gateway-token
GEMINI_API_KEY=smoke-gemini-key
AUTH0_DOMAIN=dev.argus.local
DEV_JWT_SECRET=smoke-dev-jwt
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
