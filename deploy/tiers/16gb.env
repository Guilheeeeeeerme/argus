# Argus resource limits — HOSTINGER 16 GB VPS tier.
# Paste into the Dokploy panel env (or set in compose env) for this tier.
#
# Argus group budget ≤ 1700 MB (api + worker + redis):
#   api 700 + worker 800 + redis 200 = 1700 MB ✓
# pipeline profile budget ≤ 2560 MB (enabled via COMPOSE_PROFILES=pipeline):
#   edge-cv 1536 + prompt-eval 512 + stream-prep 256 + stream-gateway 128
#   + stream-gateway-sync 128 = 2560 MB exactly ✓
# (Dokploy + Traefik, Garage, Headroom and observability consume the rest of
# the 16 GB budget; see infra docs/plans memory table.)

COMPOSE_PROFILES=pipeline

API_MEM_LIMIT=700m
API_CPUS=0.75
WORKER_MEM_LIMIT=800m
WORKER_CPUS=1.0
REDIS_MEM_LIMIT=200m
MIGRATE_MEM_LIMIT=512m

GATEWAY_MEM_LIMIT=128m
SYNC_MEM_LIMIT=128m
PREP_MEM_LIMIT=256m
EDGE_MEM_LIMIT=1536m
EVAL_MEM_LIMIT=512m
