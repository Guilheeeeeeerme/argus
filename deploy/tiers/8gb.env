# Argus resource limits — HOSTINGER 8 GB VPS tier.
#
# Argus group budget ≤ 1150 MB (api + worker + redis):
#   api 500 + worker 500 + redis 150 = 1150 MB ✓
#
# The `pipeline` profile (edge-cv + prompt-eval + stream-prep +
# stream-gateway + stream-gateway-sync) stays OFF on this tier: the vision
# pipeline needs ≥ 2560 MB (edge-cv torch alone is 1536 MB) and cannot share
# the 8 GB budget with the other apps (PromptDesk 1400, Quizzeira core 1750…).
# Just leave COMPOSE_PROFILES unset; profiled services are not created.
COMPOSE_PROFILES=

API_MEM_LIMIT=500m
API_CPUS=0.5
WORKER_MEM_LIMIT=500m
WORKER_CPUS=0.5
REDIS_MEM_LIMIT=150m
REDIS_CPUS=0.25
MIGRATE_MEM_LIMIT=384m
